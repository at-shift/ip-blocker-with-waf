#: includes/class-admin.php:204
msgid "Local WAF records"
msgstr "Registros locales del WAF"

#: includes/class-admin.php:206
msgid "Source"
msgstr "Origen"

#: includes/class-admin.php:207
msgid "Period"
msgstr "Periodo"

#: includes/class-admin.php:207
msgid "24 hours"
msgstr "24 horas"

#: includes/class-admin.php:207
msgid "7 days"
msgstr "7 días"

#: includes/class-admin.php:207
msgid "30 days"
msgstr "30 días"

#: includes/class-admin.php:208
msgid "Include below-threshold groups"
msgstr "Incluir grupos por debajo del umbral"

#: includes/class-admin.php:209
msgid "Read logs"
msgstr "Leer registros"

#: includes/class-admin.php:210
msgid "Up to 10,000 retained rows and 200 IP/classification groups. Counts are source-specific records, not confirmed attacks. No automatic polling or external sharing."
msgstr "Hasta 10.000 filas conservadas y 200 grupos de IP y clasificación. Las cifras corresponden a registros específicos de cada origen, no a ataques confirmados. No se realizan consultas automáticas periódicas ni se comparten datos fuera del sitio."

#: includes/class-admin.php:212
msgid "This source is disabled. Enable it in Connections & safety to read its IP records."
msgstr "Este origen está desactivado. Actívelo en «Conexiones y seguridad» para leer sus registros de IP."

#. translators: 1: minimum record count, 2: rolling window duration in minutes.
#: includes/class-admin.php:217
#, php-format
msgid "Candidate threshold: %1$d records of the same classification from the same IP within any %2$d-minute window in this period. This is not proof of identical payloads or an attack."
msgstr "Umbral de candidatos: %1$d registros de la misma clasificación y de la misma IP en cualquier ventana de %2$d minutos dentro de este periodo. Esto no demuestra que las cargas útiles sean idénticas ni que se trate de un ataque."

#: includes/class-admin.php:218
msgid "CloudSecure retained detections may include records that were not blocked."
msgstr "Las detecciones conservadas de CloudSecure pueden incluir registros que no se bloquearon."

#: includes/class-admin.php:218
msgid "Wordfence uses retained blocked:waf records with a valid category. Generic blocks, learning-mode logs and unknown categories are not combined into candidates."
msgstr "Para Wordfence se utilizan los registros blocked:waf conservados que tienen una categoría válida. Los bloqueos genéricos, los registros del modo de aprendizaje y las categorías desconocidas no se agrupan para formar candidatos."

