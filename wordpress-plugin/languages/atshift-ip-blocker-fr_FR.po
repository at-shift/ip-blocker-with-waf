#. Plugin Name of the plugin
#: atshift-ip-blocker.php
msgid "atshift IP Blocker"
msgstr "atshift IP Blocker"

#. Description of the plugin
#: atshift-ip-blocker.php
msgid "Review local WAF IP observations and manually manage server-side IP blocks with backups and rollback checks."
msgstr "Examinez les observations locales du WAF concernant les IP et gérez manuellement les blocages d’IP côté serveur avec des sauvegardes et des vérifications de retour à l’état précédent."

#. Author of the plugin
#: atshift-ip-blocker.php
msgid "@shift"
msgstr "@shift"

