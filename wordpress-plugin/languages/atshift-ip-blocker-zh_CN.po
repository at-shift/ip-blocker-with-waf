msgstr "本地 WAF 记录"

#: includes/class-admin.php:206
msgid "Source"
msgstr "来源"

#: includes/class-admin.php:207
msgid "Period"
msgstr "时间范围"

#: includes/class-admin.php:207
msgid "24 hours"
msgstr "24 小时"

#: includes/class-admin.php:207
msgid "7 days"
msgstr "7 天"

#: includes/class-admin.php:207
msgid "30 days"
msgstr "30 天"

#: includes/class-admin.php:208
