#. Plugin Name of the plugin
#: atshift-ip-blocker.php
msgid "atshift IP Blocker"
msgstr "atshift IP Blocker"

#. Description of the plugin
#: atshift-ip-blocker.php
msgid "Review local WAF IP observations and manually manage server-side IP blocks with backups and rollback checks."
msgstr "Przeglądaj lokalne zapisy WAF dotyczące adresów IP i ręcznie zarządzaj blokadami IP na serwerze z kopiami zapasowymi i kontrolą wycofywania zmian."

#. Author of the plugin
#: atshift-ip-blocker.php
msgid "@shift"
msgstr "@shift"

#: includes/class-admin.php:19
#: includes/class-sources.php:59
msgid "Administrator access on a single-site installation is required."
msgstr "Wymagane są uprawnienia administratora w instalacji WordPress z pojedynczą witryną."

#: includes/class-admin.php:60
#: includes/class-admin.php:63
msgid "Enter no more than 50 valid protected IP addresses."
msgstr "Wprowadź nie więcej niż 50 prawidłowych chronionych adresów IP."

#: includes/class-admin.php:76
msgid "Settings saved."
msgstr "Ustawienia zostały zapisane."

#: includes/class-admin.php:90
msgid "Backup not found."
msgstr "Nie znaleziono kopii zapasowej."

#: includes/class-admin.php:113
#: includes/class-admin.php:141
msgid "Enable server editing in Connections first."
msgstr "Najpierw włącz edycję ustawień serwera w sekcji „Połączenia i bezpieczeństwo”."

#: includes/class-admin.php:116
msgid "Both address attribution and independent recovery access must be confirmed."
msgstr "Należy potwierdzić zarówno pochodzenie adresów, jak i niezależny dostęp umożliwiający przywrócenie pliku."

#: includes/class-admin.php:118
msgid "The preview expired or was already used. Create a new preview."
msgstr "Podgląd wygasł lub został już użyty. Utwórz nowy podgląd."

#: includes/class-admin.php:120
msgid "Download the current .htaccess backup from this preview before applying. An old or expired download cannot be used."
msgstr "Przed zastosowaniem zmian pobierz kopię zapasową bieżącego pliku .htaccess z tego podglądu. Stara lub wygasła pobrana kopia nie może zostać użyta."

#: includes/class-admin.php:125
msgid "Server settings updated and the site self-check passed. This does not prove that a selected remote IP was blocked."
msgstr "Ustawienia serwera zostały zaktualizowane, a autotest witryny zakończył się pomyślnie. Nie dowodzi to zablokowania wybranego zdalnego adresu IP."

#: includes/class-admin.php:134
msgid "SDN measurement resumed. Interrupted windows remain indeterminate; the SDN mode and assignment were not changed."
msgstr "Pomiar SDN został wznowiony. Przerwane okna pozostają nierozstrzygnięte; tryb ani przydział SDN nie zostały zmienione."

#: includes/class-admin.php:149
#: includes/class-ip-rules.php:74
msgid "Enter no more than 50 exact public IP addresses, one per line."
msgstr "Wprowadź nie więcej niż 50 pełnych publicznych adresów IP, po jednym w wierszu."

#: includes/class-admin.php:151
msgid "Select at least one repeated candidate."
msgstr "Wybierz co najmniej jednego kandydata z powtarzającymi się zapisami."

#: includes/class-admin.php:158
msgid "The preview could not be saved."
msgstr "Nie udało się zapisać podglądu."

#: includes/class-admin.php:171
msgid "Plugin views"
msgstr "Widoki wtyczki"

#: includes/class-admin.php:172
msgid "WAF observations"
msgstr "Obserwacje WAF"

#: includes/class-admin.php:172
msgid "Server blocks"
msgstr "Blokady na serwerze"

#: includes/class-admin.php:172
#: includes/class-admin.php:277
msgid "Connections & safety"
msgstr "Połączenia i bezpieczeństwo"

#: includes/class-admin.php:189
msgid "SQL injection"
msgstr "Wstrzykiwanie SQL"

#: includes/class-admin.php:189
msgid "Cross-site scripting"
msgstr "Wykonywanie skryptów między witrynami (XSS)"

#: includes/class-admin.php:189
msgid "OS command injection"
msgstr "Wstrzykiwanie poleceń systemu operacyjnego"

#: includes/class-admin.php:189
msgid "Code injection"
msgstr "Wstrzykiwanie kodu"

#: includes/class-admin.php:189
msgid "Mail header injection"
msgstr "Wstrzykiwanie nagłówków poczty"

#: includes/class-admin.php:204
msgid "Local WAF records"
msgstr "Lokalne zapisy WAF"

#: includes/class-admin.php:206
msgid "Source"
msgstr "Źródło"

#: includes/class-admin.php:207
msgid "Period"
msgstr "Okres"

#: includes/class-admin.php:207
msgid "24 hours"
msgstr "24 godziny"

#: includes/class-admin.php:207
msgid "7 days"
msgstr "7 dni"

#: includes/class-admin.php:207
msgid "30 days"
msgstr "30 dni"

#: includes/class-admin.php:208
msgid "Include below-threshold groups"
msgstr "Uwzględnij grupy poniżej progu"

#: includes/class-admin.php:209
msgid "Read logs"
msgstr "Odczytaj dzienniki"

#: includes/class-admin.php:210
msgid "Up to 10,000 retained rows and 200 IP/classification groups. Counts are source-specific records, not confirmed attacks. No automatic polling or external sharing."
msgstr "Do 10 000 zachowanych wierszy i 200 grup według adresu IP i klasyfikacji. Liczniki dotyczą zapisów z danego źródła, a nie potwierdzonych ataków. Brak automatycznego odpytywania i udostępniania danych na zewnątrz."

#: includes/class-admin.php:212
msgid "This source is disabled. Enable it in Connections & safety to read its IP records."
msgstr "To źródło jest wyłączone. Włącz je w sekcji „Połączenia i bezpieczeństwo”, aby odczytać zapisy dotyczące adresów IP."

#. translators: 1: minimum record count, 2: rolling window duration in minutes.
#: includes/class-admin.php:217
#, php-format
msgid "Candidate threshold: %1$d records of the same classification from the same IP within any %2$d-minute window in this period. This is not proof of identical payloads or an attack."
msgstr "Próg kwalifikacji kandydatów: liczba zapisów tej samej klasyfikacji z tego samego adresu IP wynosi co najmniej %1$d w dowolnym oknie o długości %2$d min w wybranym okresie. Nie dowodzi to identyczności zawartości żądań ani wystąpienia ataku."

#: includes/class-admin.php:218
msgid "CloudSecure retained detections may include records that were not blocked."
msgstr "Zachowane wykrycia CloudSecure mogą obejmować zapisy dotyczące żądań, które nie zostały zablokowane."

#: includes/class-admin.php:218
msgid "Wordfence uses retained blocked:waf records with a valid category. Generic blocks, learning-mode logs and unknown categories are not combined into candidates."
msgstr "W przypadku Wordfence używane są zachowane zapisy blocked:waf z prawidłową kategorią. Ogólne blokady, dzienniki trybu uczenia i nieznane kategorie nie są łączone przy wyznaczaniu kandydatów."

#: includes/class-admin.php:221
#: includes/class-admin.php:228
msgid "Select"
msgstr "Wybierz"

#: includes/class-admin.php:221
#: includes/class-admin.php:228
msgid "Classification"
msgstr "Klasyfikacja"

#: includes/class-admin.php:221
#: includes/class-admin.php:228
msgid "Records"
msgstr "Liczba zapisów"

#: includes/class-admin.php:221
#: includes/class-admin.php:228
msgid "Peak in window"
msgstr "Maksimum w oknie"

#: includes/class-admin.php:221
#: includes/class-admin.php:228
msgid "Last seen"
msgstr "Ostatnia obserwacja"

#: includes/class-admin.php:221
#: includes/class-admin.php:228
msgid "Eligibility"
msgstr "Możliwość wyboru"

#. translators: %s: exact IP address to select for manual review.
#: includes/class-admin.php:226
#, php-format
msgid "Select %s"
msgstr "Wybierz %s"

#: includes/class-admin.php:228
msgid "Review required"
msgstr "Wymaga weryfikacji"

#: includes/class-admin.php:228
msgid "Below threshold"
msgstr "Poniżej progu"

#: includes/class-admin.php:228
msgid "Protected / non-public"
msgstr "Chroniony / niepubliczny"

#: includes/class-admin.php:230
msgid "No matching groups for this period and threshold."
msgstr "Brak grup pasujących do tego okresu i progu."

#: includes/class-admin.php:231
msgid "Preview selected IP blocks"
msgstr "Podgląd blokad wybranych adresów IP"

#: includes/class-admin.php:235
msgid "Managed server blocks"
msgstr "Zarządzane blokady na serwerze"

#: includes/class-admin.php:240
msgid "Server editing is disabled. Viewing does not change the file."
msgstr "Edycja ustawień serwera jest wyłączona. Samo przeglądanie nie zmienia pliku."

#: includes/class-admin.php:241
msgid "Only this plugin's managed section is edited. Existing manual deny rules remain outside its control. Blocks remain after deactivation or uninstall."
msgstr "Edytowana jest tylko sekcja zarządzana przez tę wtyczkę. Istniejące ręczne reguły odmowy dostępu pozostają poza jej kontrolą. Blokady pozostają po wyłączeniu lub odinstalowaniu wtyczki."

#: includes/class-admin.php:246
msgid "Resume SDN measurement"
msgstr "Wznów pomiar SDN"

#: includes/class-admin.php:249
msgid "SDN stays active. Undecided observation windows overlapping a server change are conservatively counted as indeterminate due to site-side restriction, not as deterrence success. No IP addresses are copied to SDN or shared."
msgstr "SDN pozostaje aktywne. Nierozstrzygnięte okna obserwacji pokrywające się ze zmianą ustawień serwera są zachowawczo uznawane za nierozstrzygnięte z powodu ograniczenia po stronie witryny, a nie za skuteczne odstraszanie. Adresy IP nie są kopiowane do SDN ani udostępniane."

#: includes/class-admin.php:257
msgid "Managed IP list"
msgstr "Zarządzana lista adresów IP"

#: includes/class-admin.php:258
msgid "Preview replacement list"
msgstr "Podgląd zastąpienia listy"

#: includes/class-admin.php:264
msgid "Recovery history"
msgstr "Historia kopii do przywracania"

#: includes/class-admin.php:264
msgid "Download backup"
msgstr "Pobierz kopię zapasową"

#: includes/class-admin.php:268
msgid "Change preview"
msgstr "Podgląd zmian"

#: includes/class-admin.php:268
msgid "Current managed section"
msgstr "Bieżąca zarządzana sekcja"

#: includes/class-admin.php:268
msgid "(empty)"
msgstr "(pusta)"

#: includes/class-admin.php:268
msgid "Proposed managed section"
msgstr "Proponowana zarządzana sekcja"

#: includes/class-admin.php:268
msgid "(remove managed section)"
msgstr "(usuń zarządzaną sekcję)"

#: includes/class-admin.php:269
msgid "Download current .htaccess backup"
msgstr "Pobierz kopię zapasową bieżącego pliku .htaccess"

#: includes/class-admin.php:271
msgid "I verified that these are client IPs, not CDN/proxy or shared-service addresses."
msgstr "Potwierdzam, że są to adresy IP klientów, a nie adresy CDN, serwerów proxy ani usług współdzielonych."

#: includes/class-admin.php:272
msgid "I saved the backup and can restore .htaccess through hosting or SFTP if WordPress becomes unreachable."
msgstr "Kopia zapasowa została przeze mnie zapisana i mam możliwość przywrócenia pliku .htaccess przez panel hostingu lub SFTP, jeśli WordPress stanie się niedostępny."

#: includes/class-admin.php:273
msgid "Apply server changes"
msgstr "Zastosuj zmiany na serwerze"

#: includes/class-admin.php:278
msgid "Read existing WAF logs"
msgstr "Odczyt istniejących dzienników WAF"

#: includes/class-admin.php:279
msgid "Raw IPs are read locally only when an administrator views the records. Provider logs are never modified. URLs, payloads, cookies and user accounts are not read."
msgstr "Surowe adresy IP są odczytywane lokalnie tylko wtedy, gdy administrator przegląda zapisy. Dzienniki źródłowe nigdy nie są modyfikowane. Adresy URL, zawartość żądań, pliki cookie i konta użytkowników nie są odczytywane."

#: includes/class-admin.php:280
msgid "Minimum repeat count"
msgstr "Minimalna liczba powtórzeń"

#: includes/class-admin.php:280
msgid "Window (minutes)"
msgstr "Okno (minuty)"

#: includes/class-admin.php:281
msgid "Protected IP addresses"
msgstr "Chronione adresy IP"

#: includes/class-admin.php:282
msgid "Your current REMOTE_ADDR and SERVER_ADDR are protected automatically. Forwarded IP headers are not trusted by this plugin. Add monitoring, proxy and administrator IPs here."
msgstr "Bieżące wartości REMOTE_ADDR i SERVER_ADDR są chronione automatycznie. Ta wtyczka nie ufa nagłówkom z przekazanymi adresami IP. Dodaj tutaj adresy IP usług monitorowania, serwerów proxy i administratorów."

#: includes/class-admin.php:283
msgid "Enable manual .htaccess editing with backup and self-check"
msgstr "Włącz ręczną edycję pliku .htaccess z kopią zapasową i autotestem"

#: includes/class-admin.php:284
msgid "Apache 2.4 and same-directory, single-site WordPress only. Self-checks cannot guarantee recovery after process termination or hosting failures. Keep independent hosting/SFTP access. No background or automatic IP blocking."
msgstr "Tylko Apache 2.4 i WordPress z pojedynczą witryną, zainstalowany w tym samym katalogu co strona główna witryny. Autotesty nie gwarantują przywrócenia po zakończeniu procesu lub awarii hostingu. Zachowaj niezależny dostęp do panelu hostingu lub SFTP. Brak blokowania adresów IP w tle lub automatycznie."

#: includes/class-admin.php:285
msgid "Up to three full configuration backups and configured IPs remain in the local database. Preview and probe tokens expire. There is no Hub, telemetry, geolocation lookup or remote block list. Uninstall does not remove server blocks or recovery data."
msgstr "W lokalnej bazie danych pozostają maksymalnie trzy pełne kopie zapasowe konfiguracji oraz skonfigurowane adresy IP. Tokeny podglądu i testów mają termin ważności. Nie ma Hub, telemetrii, sprawdzania geolokalizacji ani zdalnej listy blokad. Odinstalowanie nie usuwa blokad na serwerze ani danych do przywracania."

#: includes/class-admin.php:286
msgid "Save settings"
msgstr "Zapisz ustawienia"

#: includes/class-ip-rules.php:83
msgid "Only exact public IPv4 or IPv6 addresses are accepted. Private, reserved, masked addresses, hostnames and ranges are not accepted."
msgstr "Akceptowane są tylko pełne publiczne adresy IPv4 lub IPv6. Adresy prywatne, zarezerwowane i zamaskowane, nazwy hostów oraz zakresy nie są akceptowane."

#: includes/class-ip-rules.php:86
msgid "The list contains your current connection, the server address, or a protected IP. Remove it before continuing."
msgstr "Lista zawiera adres IP bieżącego połączenia, adres serwera lub chroniony adres IP. Usuń go przed kontynuowaniem."

#: includes/class-ip-rules.php:113
msgid "The settings file is unreadable or larger than 128 KiB."
msgstr "Plik ustawień jest nieczytelny lub ma rozmiar większy niż 128 KiB."

#: includes/class-ip-rules.php:121
#: includes/class-ip-rules.php:125
msgid "The managed section is ambiguous or was moved. Restore or review it manually."
msgstr "Nie można jednoznacznie zidentyfikować zarządzanej sekcji lub została ona przeniesiona. Przywróć ją lub sprawdź ręcznie."

#: includes/class-ip-rules.php:132
msgid "The managed section was edited outside this plugin. No changes were made."
msgstr "Zarządzana sekcja została zmieniona poza tą wtyczką. Nie wprowadzono żadnych zmian."

#: includes/class-server-file.php:13
msgid "An existing, regular .htaccess file of at most 128 KiB is required. Symbolic links are not supported."
msgstr "Wymagany jest istniejący zwykły plik .htaccess o rozmiarze do 128 KiB. Dowiązania symboliczne nie są obsługiwane."

#: includes/class-server-file.php:16
#: includes/class-server-file.php:29
msgid "The settings file could not be read."
msgstr "Nie udało się odczytać pliku ustawień."

#: includes/class-server-file.php:22
#: includes/class-server-file.php:64
#: includes/class-server-file.php:82
msgid "The settings file changed. Create a fresh preview before applying."
msgstr "Plik ustawień uległ zmianie. Przed zastosowaniem zmian utwórz nowy podgląd."

#: includes/class-server-file.php:26
msgid "The file or its directory is not writable, or the result exceeds 128 KiB."
msgstr "Nie można zapisywać do pliku lub w jego katalogu albo wynik przekracza 128 KiB."

#: includes/class-server-file.php:32
msgid "Use non-executable file permissions without group or world write access before editing."
msgstr "Przed edycją ustaw uprawnienia pliku bez prawa wykonywania oraz bez prawa zapisu dla grupy i pozostałych użytkowników."

#: includes/class-server-file.php:39
msgid "A private temporary file could not be created."
msgstr "Nie udało się utworzyć prywatnego pliku tymczasowego."

#: includes/class-server-file.php:70
msgid "The settings file could not be replaced. No partial file was installed."
msgstr "Nie udało się zastąpić pliku ustawień. Nie zainstalowano częściowo zapisanego pliku."

#: includes/class-server-file.php:84
msgid "No changes to apply."
msgstr "Brak zmian do zastosowania."

#: includes/class-server-file.php:86
msgid "The preflight site check failed. The settings file was not changed."
msgstr "Wstępny test witryny nie powiódł się. Plik ustawień nie został zmieniony."

#: includes/class-server-file.php:87
msgid "The database backup could not be saved. The settings file was not changed."
msgstr "Nie udało się zapisać kopii zapasowej w bazie danych. Plik ustawień nie został zmieniony."

#: includes/class-server-file.php:89
msgid "Preflight or backup failed. The settings file was not changed."
msgstr "Wstępny test lub tworzenie kopii zapasowej nie powiodły się. Plik ustawień nie został zmieniony."

#: includes/class-server-file.php:97
msgid "The file changed again during verification. Review its current contents before retrying."
msgstr "Plik ponownie uległ zmianie podczas weryfikacji. Przed ponowną próbą sprawdź jego bieżącą zawartość."

#: includes/class-server-file.php:101
msgid "The site check failed and automatic rollback could not safely complete. Restore the downloaded backup through your hosting panel or SFTP immediately."
msgstr "Test witryny nie powiódł się i nie udało się bezpiecznie zakończyć automatycznego wycofywania zmian. Natychmiast przywróć pobraną kopię zapasową przez panel hostingu lub SFTP."

#: includes/class-server-file.php:102
msgid "The site check failed. The previous file was restored automatically."
msgstr "Test witryny nie powiódł się. Poprzedni plik został przywrócony automatycznie."

#: includes/class-server.php:22
msgid "A previous server change interrupted SDN measurement. Review the current file and resume measurement below before another change."
msgstr "Poprzednia zmiana ustawień serwera przerwała pomiar SDN. Przed kolejną zmianą sprawdź bieżący plik i wznów pomiar poniżej."

#: includes/class-server.php:25
msgid "Update Semantic Deterrence to version 0.1.8 or later to change IP blocks while its responses or observation windows are active."
msgstr "Zaktualizuj Semantic Deterrence do wersji 0.1.8 lub nowszej, aby zmieniać blokady IP, gdy jego odpowiedzi lub okna obserwacji są aktywne."

#: includes/class-server.php:34
msgid "SDN measurement state is unavailable. Server changes are disabled until it can be read."
msgstr "Stan pomiaru SDN jest niedostępny. Zmiany ustawień serwera są wyłączone do czasu jego odczytania."

#: includes/class-server.php:41
msgid "Compatible SDN measurement support and administrator access are required."
msgstr "Wymagane są zgodna obsługa pomiaru SDN i uprawnienia administratora."

#: includes/class-server.php:43
msgid "No interrupted SDN measurement is available to resume."
msgstr "Brak przerwanego pomiaru SDN do wznowienia."

#: includes/class-server.php:48
#: includes/class-server.php:150
msgid "Another change is in progress. Try again later."
msgstr "Trwa inna zmiana. Spróbuj ponownie później."

#: includes/class-server.php:53
msgid "The site self-check failed. Measurement remains interrupted; review the server configuration and recovery access."
msgstr "Autotest witryny nie powiódł się. Pomiar pozostaje przerwany; sprawdź konfigurację serwera i dostęp umożliwiający przywrócenie pliku."

#: includes/class-server.php:55
msgid "SDN measurement could not be resumed. No server file was changed by this recovery attempt."
msgstr "Nie udało się wznowić pomiaru SDN. Ta próba przywrócenia nie zmieniła żadnego pliku serwera."

#: includes/class-server.php:70
msgid "Editing requires Apache 2.4, a single-site installation, and enabled WordPress file modifications."
msgstr "Edycja wymaga Apache 2.4, instalacji z pojedynczą witryną i włączonej możliwości modyfikacji plików WordPress."

#: includes/class-server.php:75
msgid "WordPress and the site home must use the same directory in this version."
msgstr "W tej wersji WordPress i strona główna witryny muszą korzystać z tego samego katalogu."

#: includes/class-server.php:136
msgid "Administrator access is required."
msgstr "Wymagane są uprawnienia administratora."

#: includes/class-server.php:138
msgid "The preview expired. Create a new preview."
msgstr "Podgląd wygasł. Utwórz nowy podgląd."

#: includes/class-server.php:147
#: includes/class-server.php:164
msgid "The change could not be completed. Review the current file and backups before retrying."
msgstr "Nie udało się ukończyć zmiany. Przed ponowną próbą sprawdź bieżący plik i kopie zapasowe."

#: includes/class-server.php:155
msgid "The server file changed. Create a new preview and download a fresh backup."
msgstr "Plik serwera uległ zmianie. Utwórz nowy podgląd i pobierz świeżą kopię zapasową."

#: includes/class-server.php:159
msgid "SDN measurement could not be protected. No server changes were started. Review the SDN measurement status before retrying."
msgstr "Nie udało się zabezpieczyć pomiaru SDN. Nie rozpoczęto żadnych zmian ustawień serwera. Przed ponowną próbą sprawdź stan pomiaru SDN."

#: includes/class-server.php:169
msgid "The file change attempt finished, but SDN measurement remains interrupted. Review the managed IP list and use Resume SDN measurement. Do not assume the file was unchanged."
msgstr "Próba zmiany pliku została zakończona, ale pomiar SDN pozostaje przerwany. Sprawdź zarządzaną listę adresów IP i użyj przycisku „Wznów pomiar SDN”. Nie zakładaj, że plik pozostał niezmieniony."

#: includes/class-sources.php:62
msgid "Unsupported log source."
msgstr "Nieobsługiwane źródło dzienników."

#: includes/class-sources.php:66
msgid "The selected WAF is not active."
msgstr "Wybrany WAF nie jest aktywny."

#: includes/class-sources.php:73
msgid "The provider log table is unavailable."
msgstr "Tabela dzienników źródłowych jest niedostępna."

#: includes/class-sources.php:89
#: includes/class-sources.php:93
msgid "The provider log could not be read. No raw database details are shown."
msgstr "Nie udało się odczytać dziennika źródłowego. Surowe szczegóły bazy danych nie są wyświetlane."
