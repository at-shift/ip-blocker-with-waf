#. Plugin Name of the plugin
#: atshift-ip-blocker.php
msgid "atshift IP Blocker"
msgstr "atshift IP Blocker"

#. Description of the plugin
#: atshift-ip-blocker.php
msgid "Review local WAF IP observations and manually manage server-side IP blocks with backups and rollback checks."
msgstr "Tinjau catatan pengamatan IP dari WAF lokal dan kelola pemblokiran IP di sisi server secara manual dengan pencadangan dan pemeriksaan pengembalian ke kondisi sebelumnya."

#. Author of the plugin
#: atshift-ip-blocker.php
msgid "@shift"
msgstr "@shift"

